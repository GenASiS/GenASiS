PATH_GENASIS = ../../../../..

all: RectangularContraction RectangularExpansion SphericalContraction

include $(PATH_GENASIS)/Build/Makefile_Build

RectangularContraction: Basics.a Mathematics.a RectangularContraction.o
	$(LINK) $(FLAGS) \
	  -o RectangularContraction_$(MACHINE) \
	  RectangularContraction.o LinearAdvection_Form.o \
	  Mathematics.a Basics.a $(LIBRARIES)

RectangularExpansion: Basics.a Mathematics.a RectangularExpansion.o
	$(LINK) $(FLAGS) \
	  -o RectangularExpansion_$(MACHINE) \
	  RectangularExpansion.o LinearAdvection_Form.o \
	  Mathematics.a Basics.a $(LIBRARIES)

SphericalContraction: Basics.a Mathematics.a SphericalContraction.o
	$(LINK) $(FLAGS) \
	  -o SphericalContraction_$(MACHINE) \
	  SphericalContraction.o LinearAdvection_Form.o \
	  Mathematics.a Basics.a $(LIBRARIES)

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MATHEMATICS)/Makefile_Dependencies

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f RectangularContraction_*
	rm -f RectangularExpansion_*
	rm -f SphericalContraction_*

LinearAdvection_Form.o: \
  Basics.a \
  Mathematics.a \
  LinearAdvection_Form.f90

RectangularContraction.o: \
  Basics.o \
  LinearAdvection_Form.o \
  RectangularContraction.f90

RectangularExpansion.o: \
  Basics.o \
  LinearAdvection_Form.o \
  RectangularExpansion.f90

SphericalContraction.o: \
  Basics.o \
  LinearAdvection_Form.o \
  SphericalContraction.f90

