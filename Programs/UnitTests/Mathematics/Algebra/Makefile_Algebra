PATH_GENASIS = ../../../../../

include $(PATH_GENASIS)/Build/Makefile_Build

all: RootFinder_Form_Test 

RootFinder_Form_Test: Basics.a Algebra.a RootFinder_Form_Test.o
	$(LINK) $(FLAGS) \
          -o RootFinder_Form_Test_$(MACHINE) \
          RootFinder_Form_Test.o \
	  Algebra.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f RootFinder_Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_ALGEBRA)/Makefile_Dependencies

RootFinder_Form_Test.o: \
  Basics.o \
  Algebra.o \
  RootFinder_Form_Test.f90
