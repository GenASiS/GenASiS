PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: Stream_C__Form_Test Stream_A__Form_Test

Stream_C__Form_Test: Basics.a Manifolds.a FieldSets.a Streams.a \
  Stream_C__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Stream_C__Form_Test_$(MACHINE) \
          Stream_C__Form_Test.o Streams.a \
          FieldSets.a Manifolds.a Basics.a $(LIBRARIES)

Stream_A__Form_Test: Basics.a Manifolds.a FieldSets.a Streams.a \
  Stream_A__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Stream_A__Form_Test_$(MACHINE) \
          Stream_A__Form_Test.o Streams.a \
          FieldSets.a Manifolds.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f Stream_C__Form_Test_*
	rm -f Stream_A__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLDS)/Makefile_Dependencies
include $(PATH_FIELD_SETS)/Makefile_Dependencies
include $(PATH_STREAMS)/Makefile_Dependencies

Stream_C__Form_Test.o: \
  Basics.o \
  Manifolds.o \
  FieldSets.o \
  Streams.o \
  Stream_C__Form_Test.f90

Stream_A__Form_Test.o: \
  Basics.o \
  Manifolds.o \
  FieldSets.o \
  Streams.o \
  Stream_A__Form_Test.f90
