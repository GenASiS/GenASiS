PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: FieldSet_C__Form_Test FieldSet_A__Form_Test

FieldSet_C__Form_Test: Basics.a Manifolds.a FieldSets.a \
  FieldSet_C__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FieldSet_C__Form_Test_$(MACHINE) \
          FieldSet_C__Form_Test.o FieldSets.a \
          Manifolds.a Basics.a $(LIBRARIES)

FieldSet_A__Form_Test: Basics.a Manifolds.a FieldSets.a \
  FieldSet_A__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FieldSet_A__Form_Test_$(MACHINE) \
          FieldSet_A__Form_Test.o FieldSets.a \
          Manifolds.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f FieldSet_C__Form_Test_*
	rm -f FieldSet_A__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLDS)/Makefile_Dependencies
include $(PATH_FIELD_SETS)/Makefile_Dependencies

FieldSet_C__Form_Test.o: \
  Basics.o \
  Manifolds.o \
  FieldSets.o \
  FieldSet_C__Form_Test.f90

FieldSet_A__Form_Test.o: \
  Basics.o \
  Manifolds.o \
  FieldSets.o \
  FieldSet_A__Form_Test.f90
