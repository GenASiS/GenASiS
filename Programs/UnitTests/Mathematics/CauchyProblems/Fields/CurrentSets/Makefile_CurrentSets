PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: CurrentSet_Form_Test FluxSet_CS__Form_Test EigenspeedSet_F__Form_Test

CurrentSet_Form_Test: Basics.a Algebra.a Manifolds.a FieldSets.a Geometries.a \
  CurrentSets.a CurrentSet_Form_Test.o
	$(LINK) $(FLAGS) \
          -o CurrentSet_Form_Test_$(MACHINE) \
          CurrentSet_Form_Test.o CurrentSets.a \
          Geometries.a FieldSets.a Manifolds.a Algebra.a Basics.a $(LIBRARIES)

FluxSet_CS__Form_Test: Basics.a Algebra.a Manifolds.a FieldSets.a Geometries.a \
  CurrentSets.a FluxSet_CS__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FluxSet_CS__Form_Test_$(MACHINE) \
          FluxSet_CS__Form_Test.o CurrentSets.a \
          Geometries.a FieldSets.a Manifolds.a Algebra.a Basics.a $(LIBRARIES)

EigenspeedSet_F__Form_Test: Basics.a Algebra.a Manifolds.a FieldSets.a \
  Geometries.a CurrentSets.a EigenspeedSet_F__Form_Test.o
	$(LINK) $(FLAGS) \
