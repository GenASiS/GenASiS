PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: Slopes.a #Reconstruction_C__Form_Test Reconstruction_A__Form_Test

Reconstruction_C__Form_Test: Basics.a Manifolds.a Fields.a Slopes.a \
  Reconstruction_C__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Reconstruction_C__Form_Test_$(MACHINE) \
          Reconstruction_C__Form_Test.o Slopes.a \
          Fields.a Manifolds.a Basics.a $(LIBRARIES)

Reconstruction_A__Form_Test: Basics.a Manifolds.a Fields.a Slopes.a \
  Reconstruction_A__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Reconstruction_A__Form_Test_$(MACHINE) \
          Reconstruction_A__Form_Test.o Slopes.a \
          Fields.a Manifolds.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f Reconstruction_C__Form_Test_*
	rm -f Reconstruction_A__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLDS)/Makefile_Dependencies
include $(PATH_FIELDS)/Makefile_Dependencies
