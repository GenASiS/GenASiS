PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: Chart_H__Form_Test FieldSet_CH__Form_Test Stream_CH__Form_Test \
  Geometry_F__Form_Test

Chart_H__Form_Test: Basics.a ManifoldBasics.a ChartBasics.a \
  Chart_H__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Chart_H__Form_Test_$(MACHINE) \
          Chart_H__Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

FieldSet_CH__Form_Test: Basics.a ManifoldBasics.a FieldSet_CH__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FieldSet_CH__Form_Test_$(MACHINE) \
          FieldSet_CH__Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

Stream_CH__Form_Test: Basics.a ManifoldBasics.a Stream_CH__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Stream_CH__Form_Test_$(MACHINE) \
          Stream_CH__Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

Geometry_F__Form_Test: Basics.a ManifoldBasics.a ChartBasics.a \
  Geometry_F__Form_Test.o
	$(LINK) $(FLAGS) \
          -o Geometry_F__Form_Test_$(MACHINE) \
          Geometry_F__Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f Chart_H__Form_Test_*
	rm -f FieldSet_CH__Form_Test_*
	rm -f Stream_CH__Form_Test_*
	rm -f Geometry_F__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLD_BASICS)/Makefile_Dependencies
include $(PATH_CHART_BASICS)/Makefile_Dependencies

Chart_H__Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ChartBasics.o \
  Chart_H__Form_Test.f90

FieldSet_CH__Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ChartBasics.o \
  FieldSet_CH__Form_Test.f90

Stream_CH__Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ChartBasics.o \
  Stream_CH__Form_Test.f90
