PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: ChartHeader_Form_Test FieldSet_CH__Form_Test

ChartHeader_Form_Test: Basics.a ManifoldBasics.a ChartBasics.a \
  ChartHeader_Form_Test.o
	$(LINK) $(FLAGS) \
          -o ChartHeader_Form_Test_$(MACHINE) \
          ChartHeader_Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

FieldSet_CH__Form_Test: Basics.a ManifoldBasics.a FieldSet_CH__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FieldSet_CH__Form_Test_$(MACHINE) \
          FieldSet_CH__Form_Test.o ChartBasics.a \
          ManifoldBasics.a Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f ChartHeader_Form_Test_*
	rm -f FieldSet_CH__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLD_BASICS)/Makefile_Dependencies
include $(PATH_CHART_BASICS)/Makefile_Dependencies

ChartHeader_Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ChartBasics.o \
  ChartHeader_Form_Test.f90

FieldSet_CH__Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ChartBasics.o \
  FieldSet_CH__Form_Test.f90
