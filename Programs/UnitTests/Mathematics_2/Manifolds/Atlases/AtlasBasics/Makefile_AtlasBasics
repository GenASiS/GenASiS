PATH_GENASIS = ../../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: \
  AtlasHeader_Form_Test

AtlasHeader_Form_Test: Basics.a AtlasBasics.a AtlasHeader_Form_Test.o
	$(LINK) $(FLAGS) \
          -o AtlasHeader_Form_Test_$(MACHINE) \
          AtlasHeader_Form_Test.o AtlasBasics.a \
          Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f AtlasHeader_Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_ATLAS_BASICS)/Makefile_Dependencies

AtlasHeader_Form_Test.o: \
  Basics.o \
  AtlasBasics.o \
  AtlasHeader_Form_Test.f90
