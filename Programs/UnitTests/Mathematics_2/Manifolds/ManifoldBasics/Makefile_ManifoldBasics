PATH_GENASIS = ../../../../../..

include $(PATH_GENASIS)/Build/Makefile_Build

all: \
  MANIFOLD_Singleton_Test ManifoldHeader_Form_Test FieldsHeader_M__Form_Test

MANIFOLD_Singleton_Test: Basics.a ManifoldBasics.a MANIFOLD_Singleton_Test.o
	$(LINK) $(FLAGS) \
          -o MANIFOLD_Singleton_Test_$(MACHINE) \
          MANIFOLD_Singleton_Test.o ManifoldBasics.a \
          Basics.a $(LIBRARIES)

ManifoldHeader_Form_Test: Basics.a ManifoldBasics.a ManifoldHeader_Form_Test.o
	$(LINK) $(FLAGS) \
          -o ManifoldHeader_Form_Test_$(MACHINE) \
          ManifoldHeader_Form_Test.o ManifoldBasics.a \
          Basics.a $(LIBRARIES)

FieldsHeader_M__Form_Test: Basics.a ManifoldBasics.a FieldsHeader_M__Form_Test.o
	$(LINK) $(FLAGS) \
          -o FieldsHeader_M__Form_Test_$(MACHINE) \
          FieldsHeader_M__Form_Test.o ManifoldBasics.a \
          Basics.a $(LIBRARIES)

clean:
	rm -f *.o *.a *.mod *.smod *.ld

clobber: clean
	rm -f MANIFOLD_Singleton_Test_*
	rm -f ManifoldHeader_Form_Test_*
	rm -f FieldsHeader_M__Form_Test_*

include $(PATH_BASICS)/Makefile_Dependencies
include $(PATH_MANIFOLD_BASICS)/Makefile_Dependencies

MANIFOLD_Singleton_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  MANIFOLD_Singleton_Test.f90

ManifoldHeader_Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  ManifoldHeader_Form_Test.f90

FieldsHeader_M__Form_Test.o: \
  Basics.o \
  ManifoldBasics.o \
  FieldsHeader_M__Form_Test.f90
